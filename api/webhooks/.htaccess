RewriteEngine On

# Разрешаем POST запросы к webhook
<Limit POST>
    Require all granted
</Limit>

# Запрещаем доступ извне к логам и конфигурации
<Files "*.log">
    Deny from all
</Files>

<Files "*.php">
    Deny from all
</Files>

# Но разрешаем доступ к обработчику webhook
<Files "payment.php">
    Allow from all
</Files>